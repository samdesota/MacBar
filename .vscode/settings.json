{
    "swift.sourcekit-lsp.serverPath": "/usr/bin/xcrun",
    "swift.sourcekit-lsp.serverArguments": [
        "sourcekit-lsp"
    ],
    "swift.disableAutoSourcekitLsp": false,
    "swift.path": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin",
    "swift.args": [
        "swift"
    ],
    "files.associations": {
        "*.swift": "swift"
    },
    "search.exclude": {
        "**/.build": true,
        "**/Packages": true,
        "**/.swiftpm": true,
        "**/DerivedData": true,
        "**/*.xcodeproj/xcuserdata": true,
        "**/*.xcodeproj/project.xcworkspace/xcuserdata": true
    },
    "swift.swiftEnvironmentVariables": {
        "DEVELOPER_DIR": "/Applications/Xcode.app"
    }
}